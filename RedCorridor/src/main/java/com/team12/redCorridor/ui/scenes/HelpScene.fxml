<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="520.0" prefWidth="523.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team12.redCorridor.ui.controllers.HelpSceneController">
   <top>
      <VBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <Label fx:id="helpMenuLabel" text="HELP MENU" VBox.vgrow="ALWAYS">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Separator prefWidth="240.0" />
         </children>
         <padding>
            <Insets bottom="12.0" top="20.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <VBox spacing="24.0" BorderPane.alignment="TOP_LEFT">
         <children>
            <VBox alignment="TOP_CENTER" prefHeight="48.0" prefWidth="506.0" spacing="8.0">
               <children>
                  <Label fx:id="movementsLabel" alignment="CENTER" prefHeight="23.0" prefWidth="123.0" text="MOVEMENTS" VBox.vgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label fx:id="movementsKeyText" alignment="CENTER" prefHeight="17.0" prefWidth="267.0" text="[W] [A] [S] [D] | [UP] [DOWN] [LEFT] [RIGHT]" wrapText="true" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" spacing="8.0">
               <children>
                  <Label fx:id="interactionsLabel" alignment="CENTER" prefHeight="23.0" prefWidth="143.0" text="INTERACTIONS" VBox.vgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
                  <Label alignment="CENTER" prefHeight="17.0" prefWidth="135.0" text="[E] Enter / Leave Room" wrapText="true" VBox.vgrow="ALWAYS" />
                  <Label alignment="CENTER" prefHeight="17.0" prefWidth="98.0" text="[F] Pick up item" wrapText="true" VBox.vgrow="ALWAYS" />
                  <Label alignment="CENTER" prefHeight="17.0" prefWidth="53.0" text="[L]obby" wrapText="true" VBox.vgrow="ALWAYS" />
                  <Label alignment="CENTER" prefHeight="17.0" prefWidth="47.0" text="[Q]uit" wrapText="true" VBox.vgrow="ALWAYS" />
               </children>
            </VBox>
            <VBox alignment="TOP_CENTER" spacing="8.0">
               <children>
                  <Label fx:id="iconsLabel" alignment="CENTER" prefHeight="23.0" prefWidth="63.0" text="ICONS" VBox.vgrow="ALWAYS">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Label>
               </children>
            </VBox>
         </children>
         <padding>
            <Insets bottom="16.0" left="32.0" right="32.0" />
         </padding>
      </VBox>
   </center>
   <bottom>
      <VBox spacing="8.0" BorderPane.alignment="CENTER">
         <children>
            <Separator />
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Label text="[B]ack" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="[L]obby" />
               </children>
               <padding>
                  <Insets bottom="16.0" left="24.0" right="24.0" top="12.0" />
            </padding>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
