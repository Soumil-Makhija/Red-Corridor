<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.team12.redCorridor.ui.controllers.LobbySceneController">
   <top>
      <VBox alignment="CENTER" spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <Label text="LOBBY">
               <font>
                  <Font name="System Bold" size="26.0" />
               </font>
            </Label>
            <Separator prefWidth="200.0" />
         </children>
         <padding>
            <Insets bottom="12.0" left="24.0" right="24.0" top="16.0" />
         </padding>
      </VBox>
   </top>
   <center>
      <StackPane alignment="TOP_CENTER" BorderPane.alignment="CENTER">
         <children>
            <Label text="Game explaination" wrapText="true">
               <font>
                  <Font size="28.0" />
               </font>
            </Label>
         </children>
         <padding>
            <Insets bottom="32.0" left="32.0" right="32.0" top="32.0" />
         </padding>
      </StackPane>
   </center>
   <bottom>
      <VBox spacing="12.0" BorderPane.alignment="CENTER">
         <children>
            <Separator />
            <HBox alignment="CENTER" spacing="16.0">
               <children>
                  <Label text="[H]elp" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="[N]ew Game" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label text="[Q]uit" />
               </children>
               <padding>
                  <Insets bottom="16.0" left="24.0" right="24.0" top="8.0" />
            </padding>
            </HBox>
         </children>
      </VBox>
   </bottom>
</BorderPane>
